# Copy to `.env` to override docker compose defaults.
#
# Public path baked into the SPA at build time. Must match the `/kroki/`
# location in nginx.conf.
KROKI_PUBLIC_URL=/kroki

# Pinned Kroki gateway image (tag + multi-arch index digest).
KROKI_IMAGE=yuzutech/kroki:0.36.0@sha256:de0f2fdc42e926d54706ac962aa5cfb38c5c387035a1b30d07ce297bbc37057b
KROKI_MEMORY_LIMIT=1g

# Loopback port used by `npm run dev` via docker-compose.dev.yml.
KROKI_HOST_PORT=8000

# Published web port.
HOST_BIND=0.0.0.0
HOST_PORT=8080
